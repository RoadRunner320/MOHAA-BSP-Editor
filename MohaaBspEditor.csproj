<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MohaaBspEditor</RootNamespace>
    <AssemblyName>MohaaBspEditor</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>MOHAA BSP Entity Editor</Product>
    <Description>Entity and script editor for compiled Medal of Honor: Allied Assault, Spearhead and Breakthrough maps.</Description>
  </PropertyGroup>

</Project>
